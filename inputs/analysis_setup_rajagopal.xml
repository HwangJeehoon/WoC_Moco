<?xml version="1.0" encoding="UTF-8" ?>
<!-- AnalyzeTool setup for rajagopal_AFO (moco_WoC_modelProfile 'rajagopal').
     Output prefix = AnalyzeTool name (rajagopal_AFO_*).
     Kinematics: coordinates (q, u, dudt) in radians, used by inverse dynamics.
     BodyKinematics center_of_mass: whole-model center of mass in ground
     (rajagopal_AFO_BodyKinematics_pos_global.sto, center_of_mass_X/Y/Z).
     No fixed body points are used as CoM/CoP: the CoP comes from the
     contact-force GRF file (moco_WoC_getResult). The model and coordinates
     file are set by WoC_moco_analysis. -->
<OpenSimDocument Version="40500">
	<AnalyzeTool name="rajagopal_AFO">
		<model_file>../models/rajagopal_AFO.osim</model_file>
		<replace_force_set>false</replace_force_set>
		<force_set_files />
		<results_directory />
		<output_precision>8</output_precision>
		<initial_time>0</initial_time>
		<final_time>100</final_time>
		<solve_for_equilibrium_for_auxiliary_states>false</solve_for_equilibrium_for_auxiliary_states>
		<maximum_number_of_integrator_steps>20000</maximum_number_of_integrator_steps>
		<maximum_integrator_step_size>1</maximum_integrator_step_size>
		<minimum_integrator_step_size>1e-08</minimum_integrator_step_size>
		<integrator_error_tolerance>1.0000000000000001e-05</integrator_error_tolerance>
		<AnalysisSet name="Analyses">
			<objects>
				<BodyKinematics name="BodyKinematics">
					<on>true</on>
					<start_time>0</start_time>
					<end_time>100</end_time>
					<step_interval>1</step_interval>
					<in_degrees>true</in_degrees>
					<bodies> center_of_mass</bodies>
					<express_results_in_body_local_frame>false</express_results_in_body_local_frame>
				</BodyKinematics>
				<Kinematics name="Kinematics">
					<on>true</on>
					<start_time>0</start_time>
					<end_time>100</end_time>
					<step_interval>1</step_interval>
					<in_degrees>false</in_degrees>
				</Kinematics>
			</objects>
			<groups />
		</AnalysisSet>
		<ControllerSet name="Controllers">
			<objects />
			<groups />
		</ControllerSet>
		<external_loads_file />
		<states_file />
		<coordinates_file />
		<speeds_file />
		<lowpass_cutoff_frequency_for_coordinates>-1</lowpass_cutoff_frequency_for_coordinates>
	</AnalyzeTool>
</OpenSimDocument>
